# Optional — OpenWisper works fully offline without any of these.
# Copy to ~/Library/Application Support/OpenWisper/.env (or keep a .env in the
# repo root for dev runs). Keys enable cloud transcription and/or LLM cleanup.

# Cloud Whisper transcription + fast LLM cleanup
GROQ_API_KEY=

# OpenAI Whisper API transcription + LLM cleanup
OPENAI_API_KEY=

# LLM cleanup via Claude
ANTHROPIC_API_KEY=
